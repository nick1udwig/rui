{
  "name": "@rui/client-browser",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm": "./wasm/rui_client_wasm_bg.wasm",
    "./compatibility.json": "./compatibility.json"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "wasm/rui_client_wasm.js",
    "wasm/rui_client_wasm.d.ts",
    "wasm/rui_client_wasm_bg.wasm",
    "wasm/rui_client_wasm_bg.wasm.d.ts",
    "compatibility.json",
    "THIRD_PARTY_NOTICES.txt",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc && node scripts/package.mjs",
    "test": "npm run build && node tests/run.mjs",
    "prepack": "npm run build",
    "compatibility:update": "node scripts/clean.mjs && tsc && node scripts/package.mjs --update",
    "test:package": "node tests/package-check.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  },
  "description": "Bounded Rust/WASM RUI browser replica, semantic controls and Canvas renderer",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26.8.1 <27"
  },
  "sideEffects": false
}
